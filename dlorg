#!/usr/bin/env bash

TARGET_DIR="$HOME/Downloads"

mkdir -p "$TARGET_DIR"/{docs,images,text,pdfs,videos,audio,archives,installers,code,other}

process_file() {
    local FILE_PATH="$1"
    local FILE_NAME="$2"
    
    local EXT="${FILE_NAME##*.}"
    EXT="${EXT,,}"

case "$EXT" in
    docx|doc|xlsx|xls|pptx|ppt|odt|rtf)
        DEST="docs"
        ;;
    jpg|jpeg|png|gif|bmp|svg|webp)
        DEST="images"
        ;;
    pdf)
        DEST="pdfs"
        ;;
    txt|md|rtf)
        DEST="text"
        ;;
    mp4|mkv|avi|mov|wmv)
        DEST="videos"
        ;;
    mp3|wav|flac|m4a|aac)
        DEST="audio"
        ;;
    exe|msi|deb)
        DEST="installers"
        ;;
    zip|tar|gz|rar|7z)
        DEST="archives"
        ;;
    py|js|html|css|cpp|sh)
        DEST="code"
        ;;
    *)
        DEST="other"
        ;;
esac

mkdir -p "$TARGET_DIR"/$DEST

    if [ -f "$FILE_PATH" ]; then
        mv "$FILE_PATH" "$TARGET_DIR/$DEST/" 2>/dev/null
        echo "Moved: $FILENAME -> $DEST/"
    fi
}

echo "Organizing existing files in $TARGET_DIR..."
for FILE in "$TARGET_DIR"/*; do
    if [ -f "$FILE" ]; then
        process_file "$FILE" "$(basename "$FILE")"
    fi
done

echo "Monitoring $TARGET_DIR for new files..."
inotifywait -m -e close_write -e moved_to  --exclude "(docs|images|pdfs|text|videos|audio|installers|archives|code|other)" --format '%f' "$TARGET_DIR" | while read -r FILENAME; do
    process_file "$TARGET_DIR/$FILENAME" "$FILENAME"
done
